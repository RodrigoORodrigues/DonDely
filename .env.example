# ============================================================================
# DON FOOD - Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env e preencha os valores
# NÃO commite o arquivo .env real (contém segredos)

# ----------------------------------------------------------------------------
# SUPABASE (Banco de dados e Realtime)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
SUPABASE_ANON_KEY=sua-anon-key

# ----------------------------------------------------------------------------
# SEGURANÇA - OBRIGATÓRIO EM PRODUÇÃO
# ----------------------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Senha do Painel de Desenvolvedor (/dev) - OBRIGATÓRIO EM PRODUÇÃO
# Acesso em: https://www.donfood.site/dev
DEV_SUPER_ADMIN_PASSWORD=Donfood2211

# ----------------------------------------------------------------------------
# GOOGLE OAUTH (Opcional - Login com Google)
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# CONFIGURAÇÕES GERAIS
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Permite limpeza de empresas órfãs no Supabase (CUIDADO: apaga dados!)
# ALLOW_REMOTE_PRUNE=true